HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
# On production use HTTPS. Reverse-proxy /api/video and the studio to this server.
WEB_ORIGINS=
DATA_DIR=./data
NODE_ENV=development
RENDER_ENABLED=false
DAILY_RENDER_LIMIT=20
XAI_API_KEY=
# Choose a model enabled on your xAI account.
XAI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Fixed price = 30 USDT / 30 days. Set and publish a CNY equivalent in integer fen.
PLAN_CNY_FEN=
USDT_NETWORK=
USDT_ADDRESS=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_SERIAL=
# PEM values may use literal \n inside a quoted value. Do not commit real keys.
ANDROID_DOWNLOAD_URL=
IOS_DOWNLOAD_URL=
