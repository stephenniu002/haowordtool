# Copy locally to .env. NEVER commit the real .env or session files.
HOST=127.0.0.1
PORT=8789
PUBLIC_ORIGIN=https://publisher.example.com
PUBLISHER_DATA_DIR=./data
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PUBLISHER_ENCRYPTION_KEY=
PUBLISHER_ADMIN_EMAIL=
PUBLISHER_ADMIN_PASSWORD=
PUBLISHER_MAX_UPLOAD_BYTES=536870912
PUBLISHER_USER_QUOTA_BYTES=5368709120
META_APP_ID=
META_APP_SECRET=
# Explicit supported Graph version from your Meta developer console, e.g. vNN.0
META_GRAPH_VERSION=
# Optional local browser worker. Absolute paths. Python 3.10–3.12.
SAU_ROOT=
PUBLISHER_PYTHON=
PUBLISHER_CHROME_PATH=
